<Page x:Class="PlantProtectionTechnologist.Pages.RecipesCreate.RecipesCreatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlantProtectionTechnologist.Pages.RecipesCreate"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RecipesCreatePage" KeepAlive="False">

    <Grid>
        <Grid x:Name="paternGrid" Margin="10 0 0 0"
              Background="White">
            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <materialDesign:Card Grid.Row="0" Padding="10"
                                 Background="#F8F9FA">
                <Grid >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding name}" Grid.Row="0"
                      FontSize="20" FontWeight="Bold"/>
                        <WrapPanel Grid.Row="1">
                            <TextBlock Text="{Binding code}" 
                       FontSize="13" Foreground="#6C757D"/>
                            <TextBlock Text="{Binding activeRecipeFill}" FontSize="13" Foreground="#6C757D"/>
                        </WrapPanel>
                    </Grid>

                    <Border CornerRadius="12" Padding="8,4" 
                Margin="2" Background="{Binding statusColor}" 
                HorizontalAlignment="Center" MinWidth="80"
                Grid.Column="1" VerticalAlignment="Center" >
                        <TextBlock Text="{Binding statusName}" FontWeight="SemiBold" Foreground="White" FontSize="13" 
                       TextAlignment="Center"/>
                    </Border>
                </Grid>
            </materialDesign:Card>

            <Grid Grid.Row="1" Margin="10 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <TextBlock Text="Дата создания" Grid.Column="0" Grid.Row="0"  FontSize="11" Foreground="#6C757D"/>
                <TextBlock Text="Автор" Grid.Column="1" Grid.Row="0"  FontSize="11" Foreground="#6C757D"/>
                <TextBlock Text="Продукт" Grid.Column="2" Grid.Row="0"  FontSize="11" Foreground="#6C757D"/>

                <TextBlock Text="{Binding dateCreate}" Grid.Column="0" Grid.Row="1" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding autor}" Grid.Column="1" Grid.Row="1" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="{Binding name}" Grid.Column="2" Grid.Row="1" FontWeight="SemiBold" FontSize="13" TextDecorations="Underline"/>
            </Grid>

            
        </Grid>

    </Grid>
</Page>

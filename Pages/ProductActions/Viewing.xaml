<Page x:Class="PlantProtectionTechnologist.Pages.ProductActions.Viewing"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlantProtectionTechnologist.Pages.ProductActions"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Viewing">

    <Grid>
        <Grid Background="#F0F2F5" Name="parentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0">
                <StackPanel Margin="30 24 30 30">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" Grid.RowSpan="2" Kind="PackageVariant" Height="30" Width="30"/>
                                <StackPanel Grid.Column="1" Margin="10 0 0 0">
                                    <TextBlock Text="Просмотр продукта" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Информация о продукте" Foreground="#666" Margin="0 3 0 0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <materialDesign:PackIcon Kind="CloseBold" Cursor="Hand" Foreground="#FF4444" HorizontalAlignment="Right" MouseLeftButtonUp="CloseAddProduct_MouseLeftButtonUp" Height="30" Width="30"/>
                    </Grid>

                    <!--Основная информация-->
                    <materialDesign:Card Margin="0 10 0 0" UniformCornerRadius="12" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10">
                                <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin="0.5,0.5" Width="20" Height="20">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="41"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>

                                <TextBlock Text="Основная информация" Margin="10 0 0 0" FontWeight="Bold"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Код продукта" Grid.Row="0"  Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" Margin="4">
                                    <Border Grid.Column="0" Background="#E8ECF0" CornerRadius="6" Padding="12,16">
                                        <TextBlock Text="{Binding code}" VerticalAlignment="Center" Foreground="#1A2332" FontWeight="SemiBold"/>
                                    </Border>

                                </StackPanel>

                                <TextBlock Text="Наименование" Grid.Row="1"  Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock  
                                 Grid.Column="1" Grid.Row="1" 
                                 Padding="0,8"  Margin="4"  
                                 Foreground="#1A2332" FontWeight="SemiBold" 
                                 FontSize="16" Name="nameProduct" Text="{Binding name}"/>
                                    <TextBlock Text="Обязательное поле" VerticalAlignment="Bottom" Name="requiredField" Foreground="#FF4444" FontWeight="SemiBold" Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock Text="Тип продукта" Grid.Column="0" Grid.Row="3"  Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" Grid.Row="2" Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="198*"/>
                                        <ColumnDefinition Width="198*"/>
                                        <ColumnDefinition Width="53*"/>
                                        <ColumnDefinition Width="145*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Height="40" 
                                       Name="type" Text="{Binding type}"
                                       Padding="0,8"  Margin="4"  
                                       Foreground="#1A2332" FontWeight="SemiBold" 
                                       FontSize="16"/>
                                    <TextBlock HorizontalAlignment="Left" Text="Форма выпуска" Margin="80,0,0,0" Grid.Column="1" Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Height="40" 
                                      Name="releaseForm" Grid.ColumnSpan="2" Text="{Binding releaseForm}" Padding="0,8"  Margin="4"  
                                      Foreground="#1A2332" FontWeight="SemiBold" 
                                      FontSize="16"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>


                    <!--Основные свойства-->
                    <materialDesign:Card UniformCornerRadius="12" Margin="0 10 0 0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10">
                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="20" Height="20"/>
                                <TextBlock Text="Примечание" Margin="10 0 0 0" FontWeight="Bold"/>
                            </StackPanel>

                            <Border BorderBrush="Black" 
                            BorderThickness="1" 
                            CornerRadius="0 0 12 12" Height="100">
                                <TextBox Foreground="#1A2332" FontWeight="SemiBold" 
                                 FontSize="16" AcceptsReturn="True" 
                                 TextWrapping="Wrap" Height="99" 
                                 VerticalScrollBarVisibility="Auto" BorderBrush="Transparent"
                                 IsHitTestVisible="False"
                                 Name="commentsProduct" Text="{Binding comment}"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>

<Page x:Class="PlantProtectionTechnologist.Production"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlantProtectionTechnologist"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:PlantProtectionTechnologist.Converts"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Production" KeepAlive="False">

    <Page.Resources>
        <DataTemplate x:Key="ActiveActionTemplate">
            <!--ActiveActionTemplate-->
            <StackPanel Orientation="Horizontal">
                <Button Background="White" BorderBrush="Transparent" ToolTip="Просмотр" Tag="0" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="Book"/>
                    </Button.Content>
                </Button>

                <!--<Button Background="White" BorderBrush="Transparent" ToolTip="Редактирование" Tag="1" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="pencil"/>
                    </Button.Content>
                </Button>-->

                <Button Background="White" BorderBrush="Transparent" ToolTip="Создать заказ" Tag="4" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="ListBox"/>
                    </Button.Content>
                </Button>

                <Button Background="White" BorderBrush="Transparent" ToolTip="Архивировать" Tag="3" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="trashcan" Foreground="#FF6666"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ArchivedActionTemplate">
            <!--ArchivedActionTemplate-->
            <StackPanel Orientation="Horizontal">
                <Button Background="White" BorderBrush="Transparent" ToolTip="Просмотр" Tag="0" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="Book"/>
                    </Button.Content>
                </Button>

                <Button Background="White" BorderBrush="Transparent" ToolTip="Восстановить" Tag="2" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="Restore" Foreground="#4FC3F7"/>
                    </Button.Content>
                </Button>

            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DraftActionTemplate">
            <!--DraftActionTemplate-->
            <StackPanel Orientation="Horizontal">
                <Button Background="White" BorderBrush="Transparent" ToolTip="Редактирование" Tag="1" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="pencil"/>
                    </Button.Content>
                </Button>

                <Button Background="White" BorderBrush="Transparent" ToolTip="Подтвердить" Tag="9" Click="ManagerActions">
                    <!--9-->
                    <Button.Content>
                        <materialDesign:PackIcon Kind="Check" Foreground="#4CAF50"/>
                    </Button.Content>
                </Button>

                <Button Background="White" BorderBrush="Transparent" ToolTip="Удалить черновик" Tag="3" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="trashcan" Foreground="#FF6666"/>
                    </Button.Content>
                </Button>

            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ConsonanceActionTemplate">
            <!--ConsonanceActionTemplate-->
            <StackPanel Orientation="Horizontal">
                <Button Background="White" BorderBrush="Transparent" ToolTip="Просмотр" Tag="0" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="Book"/>
                    </Button.Content>
                </Button>

                <Button Background="White" BorderBrush="Transparent" ToolTip="Редактирование" Tag="1" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="pencil"/>
                    </Button.Content>
                </Button>

                <!--<Button Background="White" BorderBrush="Transparent" ToolTip="Подтвердить" Tag="5" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="Check" Foreground="#4CAF50"/>
                    </Button.Content>
                </Button>-->

                <Button Background="White" BorderBrush="Transparent" ToolTip="Архивировать" Tag="3" Click="ManagerActions">
                    <Button.Content>
                        <materialDesign:PackIcon Kind="trashcan" Foreground="#FF6666"/>
                    </Button.Content>
                </Button>

            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DefaultActionTemplate">
            <StackPanel>
                <TextBlock Text="Ошибка" Foreground="#FF6666"/>
            </StackPanel>
        </DataTemplate>

        <converters:ActionTemplateSelector x:Key="ActionTemplateSelector" ActiveTemplate="{StaticResource ActiveActionTemplate}" 
                                           ArchivedTemplate="{StaticResource ArchivedActionTemplate}" 
                                           DefaultTemplate="{StaticResource DefaultActionTemplate}"
                                           DraftTemplate="{StaticResource DraftActionTemplate}"
                                           ConsonanceTemplate="{StaticResource ConsonanceActionTemplate}"/>
    </Page.Resources>


    <Grid>
        <Border x:Name="blurBorder">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="0" ShadowDepth="2"/>
            </Border.Effect>
            <Grid Background="#F0F2F5" Name="parentGrid" >
                <ScrollViewer>
                    <StackPanel Margin="30 24 30 30">

                        <materialDesign:Card UniformCornerRadius="12">

                            <Grid Margin="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <materialDesign:Card UniformCornerRadius="12" Width="330" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <Canvas Margin="0 7 0 0" Visibility="Visible" Name="textBoxSearcgProduction">
                                            <materialDesign:PackIcon Kind="Magnify" Canvas.Left="5" Foreground="#666" Width="18" Height="18"/>
                                            <TextBlock Text="Поиск по названию или коду..." Canvas.Left="22" Canvas.Bottom="6" Foreground="#666" FontSize="16" IsHitTestVisible="False" />
                                        </Canvas>

                                        <Border Width="330" BorderBrush="Black" BorderThickness="1" Height="32" CornerRadius="12">
                                            <TextBox Style="{StaticResource MaterialDesignComboBoxEditableTextBox}" Width="320" FontSize="16" VerticalAlignment="Center" BorderBrush="Transparent" TextChanged="TextBox_TextChanged" Name="searchName"/>
                                        </Border>
                                    </StackPanel>

                                </materialDesign:Card>

                                <StackPanel  Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox  FontSize="13" Margin="0,0,8,0" Background="White" BorderBrush="#D0D0D0"  SelectionChanged="ComboBox_SelectionChanged" Name="filterType">

                                    </ComboBox>

                                    <Button Margin="0 0 10 0" Click="AddProduct_Click">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="AddBold" Foreground="White" VerticalAlignment="Center"/>
                                                <TextBlock Text="Создать продукт" Foreground="White"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>

                                    <Button Margin="0 0 10 0" Background="Transparent" BorderBrush="Black" Click="ManagerExport_Click" Tag="0">
                                        <Button.Content>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Export" Foreground="Black" VerticalAlignment="Center"/>
                                                <TextBlock Text="Экспорт" Foreground="Black"/>
                                            </StackPanel>
                                        </Button.Content>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </materialDesign:Card>


                        <DataGrid Name="productsDataGrid" AutoGenerateColumns="False" IsReadOnly="True" HorizontalAlignment="Center" Cursor="">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Код" Binding="{Binding code}" Width="Auto"/>
                                <DataGridTextColumn Header="Наименование" Binding="{Binding name}" Width="Auto"/>
                                <DataGridTextColumn Header="Тип" Binding="{Binding type}" Width="Auto"/>
                                <DataGridTextColumn Header="Форма выпуска" Binding="{Binding releaseForm}" Width="Auto"/>

                                <DataGridTemplateColumn Header="Статус" Width="Auto">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" 
                            Padding="8,4" 
                            Margin="2"
                            Background="{Binding statusColor}"
                            HorizontalAlignment="Center"
                            MinWidth="80">
                                                <TextBlock Text="{Binding statusName}" 
                                   Foreground="White" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   TextAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Действующая рецептура" Binding="{Binding activeRecipeFill}" Width="Auto"/>
                                <DataGridTextColumn Header="Технологическая карта" Binding="{Binding activeTechMapFill}" Width="Auto"/>
                                <DataGridTemplateColumn Header="Действие" Width="Auto" CellTemplateSelector="{StaticResource ActionTemplateSelector}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid  Visibility="Collapsed" Name="Loaded" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <materialDesign:Card Width="100" Height="100" UniformCornerRadius="50">
                    <Grid>
                        <Canvas Panel.ZIndex="2" Width="100" Height="100">
                            <Ellipse Name="Circle" Fill="Black" Width="20" Height="20" Canvas.Left="40" Canvas.Top="40"/>
                        </Canvas>
                        <Ellipse Fill="Blue" Panel.ZIndex="1"/>
                        <Ellipse Fill="Wheat" Panel.ZIndex="3" Width="90" Height="90" Visibility="Visible"/>
                        <TextBlock Name="loadedText" Text="Загрузка..." HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation From="0" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                </materialDesign:Card>
            </Border>
        </Grid>

        <Grid Visibility="Collapsed" Name="selecteExport" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border>
                <materialDesign:Card x:Name="confirmationCard" Height="Auto" Padding="20" UniformCornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" Grid.ColumnSpan="2" 
                                             Background="#FFF8E1" UniformCornerRadius="12" 
                                             Padding="10" Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Height="20" Width="20" 
                                                         Kind="HelpCircle" Grid.Column="0" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Выберите способ экспорта" 
                           Grid.Column="1" 
                           Margin="10,0,0,0" 
                           FontWeight="SemiBold" 
                           Foreground="#1A2332"
                           TextWrapping="Wrap"/>
                            </Grid>
                        </materialDesign:Card>


                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" 
                                    Orientation="Horizontal" HorizontalAlignment="Center" 
                                    Margin="0,15,0,0">
                            <Button  Height="40" Background="#FF4444" Foreground="White" Padding="20,10"
                    Margin="0,0,10,0" Content="Выйти" Tag="1" Click="ManagerExport_Click"/>

                            <Button Height="40" Background="#217346" Foreground="White" Padding="20,10"
                    Margin="0,0,10,0" Click="Excel_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="MicrosoftExcel" VerticalAlignment="Center"/>
                                        <TextBlock Text="Excel"/>
                                    </StackPanel>

                                </Button.Content>
                            </Button>

                            <Button Height="40" Background="#1A3C6E" Foreground="White" Padding="20,10" Click="CSV_Click">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileCsvOutline" VerticalAlignment="Center"/>
                                        <TextBlock Text="CSV"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Border>
        </Grid>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Name="successfully" Visibility="Collapsed">
            <materialDesign:Card UniformCornerRadius="12" Width="150" Height="150">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <Border CornerRadius="50" Width="50" Height="50" Background="#4CAF50" BorderThickness="1" Grid.Row="0" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Foreground="White" Kind="SuccessBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Успешно" Grid.Row="1" HorizontalAlignment="Center"/>
                    <Button Content="Ок" Grid.Row="2" Click="CloseExport_Click" Foreground="White" Width="50"/>
                </Grid>

            </materialDesign:Card>
        </Grid>
    </Grid>
</Page>

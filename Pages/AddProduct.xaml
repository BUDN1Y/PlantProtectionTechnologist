<Page x:Class="PlantProtectionTechnologist.Pages.AddProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlantProtectionTechnologist.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="AddProduct" KeepAlive="False">

    <Grid>
        <Grid Background="#F0F2F5" Name="parentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0">
                <StackPanel Margin="30 24 30 30">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Grid.Column="0" Grid.RowSpan="2" Kind="AddBold" Height="30" Width="30"/>
                                <StackPanel Grid.Column="1" Margin="10 0 0 0">
                                    <TextBlock Text="Создание нового продукта" FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="Заполните информацию о новом продукте" Foreground="#666" Margin="0 3 0 0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <materialDesign:PackIcon Kind="CloseBold" Cursor="Hand" Foreground="#FF4444" HorizontalAlignment="Right" MouseLeftButtonUp="CloseAddProduct_MouseLeftButtonUp" Height="30" Width="30"/>
                    </Grid>

                    <!--Основная информация-->
                    <materialDesign:Card Margin="0 10 0 0" UniformCornerRadius="12" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10">
                                <materialDesign:PackIcon Kind="Pin" RenderTransformOrigin="0.5,0.5" Width="20" Height="20">
                                    <materialDesign:PackIcon.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="41"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </materialDesign:PackIcon.RenderTransform>
                                </materialDesign:PackIcon>

                                <TextBlock Text="Основная информация" Margin="10 0 0 0" FontWeight="Bold"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Код продукта" Grid.Row="0"  Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="1" Grid.Row="0" Margin="4">
                                    <Border Grid.Column="0" Background="#E8ECF0" CornerRadius="6" Padding="12,16">
                                        <TextBlock Text="{Binding textCode}" VerticalAlignment="Center" Foreground="#1A2332" FontWeight="SemiBold"/>
                                    </Border>

                                </StackPanel>

                                <TextBlock Text="Наименование" Grid.Row="1"  Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBox BorderBrush="Black" BorderThickness="1" 
                                         Grid.Column="1" Grid.Row="1" 
                                         Padding="0,8"  Margin="4"  
                                         Foreground="#1A2332" FontWeight="SemiBold" 
                                         FontSize="16" Name="nameProduct"/>
                                    <TextBlock Text="Обязательное поле" VerticalAlignment="Bottom" Name="requiredField" Foreground="#FF4444" FontWeight="SemiBold" Visibility="Collapsed"/>
                                </StackPanel>

                                <TextBlock Text="Тип продукта" Grid.Column="0" Grid.Row="3"  Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Grid Grid.Column="2" Grid.Row="2" Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="198*"/>
                                        <ColumnDefinition Width="198*"/>
                                        <ColumnDefinition Width="53*"/>
                                        <ColumnDefinition Width="145*"/>
                                    </Grid.ColumnDefinitions>

                                    <ComboBox Grid.Column="0" Height="40" 
                                              FontSize="14" Name="typeProduct" 
                                              SelectionChanged="typeProduct_SelectionChanged"/>
                                    <TextBlock HorizontalAlignment="Left" Text="Форма выпуска" Margin="80,0,0,0" Grid.Column="1" Foreground="#1A2332" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" Height="40" 
                                              FontSize="14" Name="releaseFormProduct" Grid.ColumnSpan="2" SelectionChanged="releaseFormProduct_SelectionChanged"/>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>


                    <!--Основные свойства-->
                    <materialDesign:Card UniformCornerRadius="12" Margin="0 10 0 0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0 10">
                                <materialDesign:PackIcon Kind="PlaylistEdit" Width="20" Height="20"/>
                                <TextBlock Text="Примечание" Margin="10 0 0 0" FontWeight="Bold"/>
                            </StackPanel>

                            <Border BorderBrush="Black" 
                                    BorderThickness="1" 
                                    CornerRadius="0 0 12 12" Height="100">
                                <TextBox Foreground="#1A2332" FontWeight="SemiBold" 
                                         FontSize="16" AcceptsReturn="True" 
                                         TextWrapping="Wrap" Height="99" 
                                         VerticalScrollBarVisibility="Auto" BorderBrush="Transparent"
                                         Name="commentsProduct"/>
                            </Border>
                        </StackPanel>
                    </materialDesign:Card>

                    <!--Tip-->
                    <materialDesign:Card Background="#FFF8E1" Margin="0 10 0 0" UniformCornerRadius="12" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <materialDesign:PackIcon Height="20" Width="20" Kind="HelpCircle" Grid.Column="0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Left" Margin="10 0 0 0">
                                <TextBlock Text="Новый продукт создается со статусом «На согласовании»" FontWeight="SemiBold" Foreground="#1A2332"/>
                                <TextBlock Text="После создания продукта вы сможете добавить рецептуры и технологические карты" Foreground="#666" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </materialDesign:Card>
                </StackPanel>

            </ScrollViewer>

            <Border BorderBrush="#E1ECF0" BorderThickness="0 1 0 0" Grid.Row="1"  Margin="30 0 30 30">
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Background="Transparent" BorderBrush="#E1ECF0" Margin="0 0 10 0" Click="Handling_Click" Tag="Черновик">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Сохранить черновик"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>

                    <Button Background="#4FC3F7" Foreground="White" Tag="На согласовании" Click="Handling_Click">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Create"  Margin="0 0 10 0" VerticalAlignment="Center"/>
                                <TextBlock Text="Создать продукт"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="Collapsed" Name="confirmation" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <materialDesign:Card x:Name="confirmationCard" 
                             Width="500" 
                             Height="Auto" 
                             MinHeight="200" 
                             Padding="20"
                             UniformCornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                   
                        <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Код продукта" 
                           Foreground="#1A2332" 
                           FontWeight="SemiBold" 
                           Margin="0,0,10,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Наименование" 
                           Foreground="#1A2332" 
                           FontWeight="SemiBold" 
                           Margin="0,0,10,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="Тип продукта" 
                           Foreground="#1A2332" 
                           FontWeight="SemiBold" 
                           Margin="0,0,10,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Форма выпуска" 
                           Foreground="#1A2332" 
                           FontWeight="SemiBold" 
                           Margin="0,0,10,5"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="Комментарий" 
                           Foreground="#1A2332" 
                           FontWeight="SemiBold" 
                           Margin="0,0,10,5"/>

                        
                        <TextBlock Grid.Row="0" Grid.Column="1" 
                           Text="{Binding textCode}" 
                           Foreground="#1A2332" 
                           Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="1" 
                           Text="{Binding textName}" 
                           Foreground="#1A2332" 
                           Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" 
                           Text="{Binding confirmationTypeProduct}" 
                           Foreground="#1A2332" 
                           Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="3" Grid.Column="1" 
                           Text="{Binding confirmationReleaseForm}" 
                           Foreground="#1A2332" 
                           Margin="0,0,0,5"/>

                       
                        <ScrollViewer Grid.Row="4" Grid.Column="1" 
                              MaxHeight="100"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,0,0,5">
                            <TextBlock Text="{Binding confirmationComment}" 
                               Foreground="#1A2332"
                               TextWrapping="Wrap"/>
                        </ScrollViewer>

               
                        <materialDesign:Card Grid.Row="5" Grid.ColumnSpan="2" 
                                     Background="#FFF8E1" 
                                     UniformCornerRadius="12" 
                                     Padding="10" 
                                     Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Height="20" 
                                                 Width="20" 
                                                 Kind="HelpCircle" 
                                                 Grid.Column="0" 
                                                 VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding confirmationStatus}" 
                                   Grid.Column="1" 
                                   Margin="10,0,0,0" 
                                   FontWeight="SemiBold" 
                                   Foreground="#1A2332"
                                   TextWrapping="Wrap"/>
                            </Grid>
                        </materialDesign:Card>

                     
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="0,15,0,0">
                            <Button Content="Отменить" Height="40"
                            Background="#FF4444" 
                            Foreground="White"
                            Padding="20,10"
                            Margin="0,0,10,0"
                            Click="Close_Click"/>
                            <Button Content="Подтвердить" Height="40"
                            Background="#4FC3F7" 
                            Foreground="White"
                            Padding="20,10"
                            Click="Confirmation_Click"/>
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>
            </Border>
        </Grid>

        <Grid Visibility="Collapsed" Name="Loaded" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <materialDesign:Card Width="100" Height="100" UniformCornerRadius="50">
                    <Grid>
                        <Canvas Panel.ZIndex="2" Width="100" Height="100">
                            <Ellipse Name="Circle" Fill="Black" Width="20" Height="20" Canvas.Left="40" Canvas.Top="40"/>
                        </Canvas>
                        <Ellipse Fill="Blue" Panel.ZIndex="1"/>
                        <Ellipse Fill="Wheat" Panel.ZIndex="3" Width="90" Height="90" Visibility="Visible"/>
                        <TextBlock Name="loadedText" Text="Загрузка..." HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation From="0" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                </materialDesign:Card>
            </Border>
        </Grid>
    </Grid>
</Page>

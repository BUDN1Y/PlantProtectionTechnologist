<Page x:Class="PlantProtectionTechnologist.Pages.Authorization"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PlantProtectionTechnologist.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="900"
      Title="Authorization" KeepAlive="False">

    <Grid>
        <Grid Background="White" Name="parentGrid" IsHitTestVisible="True" >

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Grid.Column="0" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/Resources/LogoFactory.png" Height="60" Width="60" Grid.Column="0"/>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Factory Industry" VerticalAlignment="Bottom" Grid.Column="1" FontSize="20"/>
                        <Rectangle Fill="Gold" Height="2" Width="160" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </Grid>

            <Image Source="/Resources/LogoTechnologist.png" Grid.Column="1" Grid.Row="0"/>

            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Grid.Row="1"  HorizontalAlignment="Stretch" >
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Войдите в Аккаунт" HorizontalAlignment="Center" FontSize="20" />

                        <TextBlock Text="Логин" Name="tipLogin_short"  Margin="10 0 0 1" FontWeight="Bold"/>
                        <TextBox  Margin="10 1 10 10"  Name="login" TextChanged="Password_TextChanged"/>


                        <TextBlock Text="Пароль" Name="tipPassword_short" Margin="10 0 0 1" FontWeight="Bold"/>
                        <TextBox Margin="10 1 10 10" Name="password" TextChanged="Login_TextChanged"/>

                        <StackPanel Name="failedAuthorization" Visibility="Hidden">
                            <TextBlock Text="Неверный логин или пароль!" Foreground="Red"/>
                            <Rectangle Height="1" Fill="Red"/>
                        </StackPanel>


                        <Canvas Margin="10 -177 0 0" Width="Auto" Height="15" Visibility="Visible" Name="tipPassword">
                            <TextBlock IsHitTestVisible="False" Text="Введите пароль" Opacity="0.8"/>
                        </Canvas>
                        <Canvas Margin="10 -70 0 0" Width="Auto" Height="15" Visibility="Visible" Name="tipLogin">
                            <TextBlock IsHitTestVisible="False" Text="Введите логин" Opacity="0.8"/>
                        </Canvas>

                        <Button Content="Войти" Margin="10" Click="Button_Click" Background="#4CAF50"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>


        <Grid Visibility="Collapsed" Name="Loaded"  HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border>
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <materialDesign:Card Width="100" Height="100" UniformCornerRadius="50">
                    <Grid>
                        <Canvas Panel.ZIndex="2" Width="100" Height="100">
                            <Ellipse Name="Circle" Fill="Black" Width="20" Height="20" Canvas.Left="40" Canvas.Top="40"/>
                        </Canvas>
                        <Ellipse Fill="Blue" Panel.ZIndex="1"/>
                        <Ellipse Fill="Wheat" Panel.ZIndex="3" Width="90" Height="90" Visibility="Visible"/>
                        <TextBlock Name="loadedText" Text="Загрузка..." HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5">
                            <TextBlock.Triggers>
                                <EventTrigger RoutedEvent="TextBlock.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation From="0" To="1" Duration="0:0:1" AutoReverse="True" RepeatBehavior="Forever" Storyboard.TargetProperty="Opacity"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </TextBlock.Triggers>
                        </TextBlock>
                    </Grid>
                </materialDesign:Card>
            </Border>
        </Grid>
    </Grid>
</Page>
